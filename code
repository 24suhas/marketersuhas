<script>
(function(){
  var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  var nav=document.querySelector('.nav'),totop=document.querySelector('.totop');
  var wipe=document.createElement('div');wipe.className='wipe';wipe.innerHTML='<span></span>';document.body.appendChild(wipe);
  var chip=document.createElement('div');chip.className='chip';chip.innerHTML='<b></b><span></span>';document.body.appendChild(chip);
  var labels={top:'Back to top \u2191',about:'About me \u270E',services:'Services \u270E',skills:'Skills \u270E',work:'My work \u270E',results:'Results \u270E',contact:'Let\u2019s talk \u270E'};
  var secs=[['#top','01','Intro','top'],['#work','02','My work','work'],['#about','03','About me','about'],['#services','04','Services','services'],['#skills','05','Skills','skills'],['.state','06','Hello','skills'],['#results','07','Results','results'],['#contact','08','Contact','contact']];
  function natTop(el){var y=0,n=el.previousElementSibling;while(n){var p=getComputedStyle(n).position;if(p!=='fixed'&&p!=='absolute')y+=n.offsetHeight;n=n.previousElementSibling;}return y;}
  var pages=[].slice.call(document.querySelectorAll('.page'));
  function setTops(){pages.forEach(function(p){p.style.top=Math.min(0,innerHeight-p.offsetHeight)+'px';});}
  function depth(){if(reduce)return;pages.forEach(function(p,i){var nx=pages[i+1];if(!nx)return;var v=Math.min(Math.max((innerHeight-nx.getBoundingClientRect().top)/innerHeight,0),1);p.style.setProperty('--p',v.toFixed(3));});}
  setTops();addEventListener('resize',setTops);addEventListener('load',setTops);if(document.fonts&&document.fonts.ready)document.fonts.ready.then(setTops);
  var busy=false,ease='cubic-bezier(.7,0,.3,1)';
  function go(id){
    var t=document.getElementById(id);if(!t)return;
    var y=id==='top'?0:Math.max(natTop(t)-nav.offsetHeight,0);
    if(reduce){scrollTo({top:y,behavior:'instant'});return;}
    if(busy)return;busy=true;
    wipe.firstChild.textContent=labels[id]||'';
    wipe.animate([{transform:'translateX(-105%)'},{transform:'translateX(0)'}],{duration:480,easing:ease,fill:'forwards'}).onfinish=function(){
      scrollTo({top:y,behavior:'instant'});
      setTimeout(function(){
        wipe.animate([{transform:'translateX(0)'},{transform:'translateX(105%)'}],{duration:520,easing:ease,fill:'forwards'}).onfinish=function(){wipe.getAnimations().forEach(function(a){a.cancel();});busy=false;};
      },280);
    };
  }
  document.addEventListener('click',function(e){
    var a=e.target.closest&&e.target.closest('a[href^="#"]');if(!a)return;
    var id=a.getAttribute('href').slice(1);if(!document.getElementById(id))return;
    e.preventDefault();go(id);
  });
  var ticking=false,cur=-1;
  function spy(){
    ticking=false;
    depth();var y=scrollY+innerHeight*.45,i=0;
    secs.forEach(function(s,k){var el=document.querySelector(s[0]);if(el&&natTop(el)<=y)i=k;});
    var sk=document.getElementById('services');
    totop.classList.toggle('show',scrollY>natTop(sk)-innerHeight*.5);
    chip.classList.toggle('show',i>0);
    if(i===cur)return;cur=i;
    var s=secs[i];
    chip.firstChild.textContent=s[1];chip.lastChild.textContent=s[2];
    chip.classList.remove('flip');void chip.offsetWidth;chip.classList.add('flip');
    document.querySelectorAll('.links a').forEach(function(l){l.classList.toggle('on',l.getAttribute('href')==='#'+s[3]);});
  }
  addEventListener('scroll',function(){if(!ticking){ticking=true;requestAnimationFrame(spy);}},{passive:true});
  addEventListener('resize',spy);spy();
})();
</script>
